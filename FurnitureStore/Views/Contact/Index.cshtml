@{
    ViewData["Title"] = "Contact Us";
}

<section class="page-header">

    <div class="container">

        <p class="eyebrow">GET IN TOUCH</p>

        <h1>Contact Us</h1>

        <p>
            Have a question about one of our furniture pieces?
            We'd love to hear from you.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="row g-5">

            <!-- STORE DETAILS -->

            <div class="col-lg-5">

                <p class="eyebrow">
                    OUR STORE
                </p>

                <h2 class="contact-title">
                    We'd love to hear from you.
                </h2>

                <p class="contact-description">
                    If you have questions about a product,
                    availability, pricing or our furniture collection,
                    contact us using any of the details below.
                </p>


                <div class="contact-details">

                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>
                            <h4>Visit Us</h4>

                            <p>
                                123 Main Street<br />
                                Durban, KwaZulu-Natal<br />
                                South Africa
                            </p>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-telephone"></i>
                        </div>

                        <div>
                            <h4>Phone</h4>

                            <a href="tel:+27310000000">
                                +27 31 000 0000
                            </a>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div>
                            <h4>Email</h4>

                            <a href="mailto:info@oakandhaven.co.za">
                                info@oakandhaven.co.za
                            </a>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-clock"></i>
                        </div>

                        <div>
                            <h4>Opening Hours</h4>

                            <p>
                                Monday – Friday: 08:00 – 17:00<br />
                                Saturday: 09:00 – 14:00<br />
                                Sunday: Closed
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <!-- CONTACT FORM -->

            <div class="col-lg-7">

                <div class="contact-form">

                    <p class="eyebrow">
                        SEND US A MESSAGE
                    </p>

                    <h2>
                        How can we help?
                    </h2>

                    <form>

                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label>
                                    Your Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Your name" />

                            </div>


                            <div class="col-md-6 mb-4">

                                <label>
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="you@example.com" />

                            </div>

                        </div>


                        <div class="mb-4">

                            <label>
                                Product
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Which product are you interested in?" />

                        </div>


                        <div class="mb-4">

                            <label>
                                Message
                            </label>

                            <textarea class="form-control"
                                      rows="6"
                                      placeholder="Tell us how we can help..."></textarea>

                        </div>


                        <button type="button"
                                class="btn btn-accent">

                            Send Message

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>