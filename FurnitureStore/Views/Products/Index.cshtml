@model List<FurnitureStore.Models.Product>

@{
    ViewData["Title"] = "Furniture";

    var categories =
        ViewBag.Categories as List<FurnitureStore.Models.Category>;

    string? currentCategory = ViewBag.CurrentCategory;
}


<section class="page-header">

    <div class="container">

        <p class="eyebrow">OUR COLLECTION</p>

        <h1>
            @(currentCategory ?? "Furniture")
        </h1>

        <p>
            Explore furniture designed to bring comfort
            and character into your home.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="category-filter">

            <a asp-controller="Products"
               asp-action="Index"
               class="filter-pill">

                All

            </a>

            @foreach (var category in categories!)
            {
                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id"
                   class="filter-pill">

                    @category.Name

                </a>
            }

        </div>


        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="product-card">

                        <div class="product-image">

                            <img src="@product.ImageUrl"
                                 alt="@product.Name" />

                            <form asp-controller="Wishlist"
                                  asp-action="Add"
                                  method="post"
                                  class="wishlist-button">

                                <input type="hidden"
                                       name="productId"
                                       value="@product.Id" />

                                <button type="submit">

                                    <i class="bi bi-heart"></i>

                                </button>

                            </form>

                        </div>

                        <div class="product-info">

                            <p class="product-category">
                                @product.CategoryName
                            </p>

                            <h3>
                                @product.Name
                            </h3>

                            <p class="product-price">
                                R @product.Price.ToString("N2")
                            </p>

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-link">

                                View details
                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>